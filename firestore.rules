rules_version = '2';

// All game mutations run through Cloud Functions (Admin SDK, which bypasses
// these rules). Clients get read access to what they are allowed to see, plus
// a single self-owned presence document per room. Nothing else is writable.
service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{code} {
      // A room is visible only to its own players.
      allow read: if request.auth != null
                  && resource != null
                  && request.auth.uid in resource.data.playerUids;
      allow write: if false;

      // Your own dealt role + word. Never another player's.
      match /private/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Votes and the round secret are function-only, unreadable by clients.
      match /votes/{uid} {
        allow read, write: if false;
      }
      match /secret/{doc} {
        allow read, write: if false;
      }

      // Lightweight presence heartbeat: read by any player in the room,
      // written only by its owner, and only the single `at` timestamp.
      match /presence/{uid} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/rooms/$(code)).data.playerUids;
        allow write: if request.auth != null
                     && request.auth.uid == uid
                     && request.resource.data.keys().hasOnly(['at'])
                     && request.resource.data.at is number;
      }
    }
  }
}
