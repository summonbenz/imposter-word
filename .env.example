# Local dev uses the Firebase Emulator Suite — no real project needed.
# `npm run dev` defaults VITE_USE_EMULATOR to 1.
#
# To point at a real Firebase project instead, fill these and set
# VITE_USE_EMULATOR=0, then copy this file to `.env`.

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_REGION=asia-southeast1

VITE_USE_EMULATOR=1
VITE_EMU_HOST=127.0.0.1
